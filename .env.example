NODE_ENV=development
PORT=3000
PAYMENT_MODE=mock
AI_MODE=mock
RECEIPT_MODE=off
ARC_EXPLORER_BASE_URL=https://testnet.arcscan.app
CIRCLE_SELLER_ADDRESS=0xSELLER
CIRCLE_GATEWAY_NETWORKS=eip155:5042002,eip155:84532
CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway.example/facilitator
CALL_LOG_PATH=artifacts/demo-run/call-log.jsonl
GATEWAY_BUYER_BASE_URL=http://127.0.0.1:3000
GATEWAY_BUYER_PRIVATE_KEY=0xyourgatewaybuyerprivatekey
GATEWAY_BUYER_CHAIN=arcTestnet
GATEWAY_BUYER_RPC_URL=https://rpc.testnet.arc.network
GATEWAY_BUYER_AUTO_DEPOSIT_AMOUNT=1.0
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Arc Proof Console 开关：默认 false，避免页面/API 在有私钥时被误触发广播。
# 只有设置为 true 后，/arc/sd/live 里的 Arc Proof Console 按钮和 POST /api/arc/proofs/* 才允许真实执行。
ARC_PROOF_CONSOLE_ENABLED=false

# Arc Testnet RPC：UsageReceipt、ERC-8004、ERC-8183 proof runners 共用。
ARC_RPC_URL=https://your-arc-rpc.example

# 项目主测试网钱包私钥：主要给 UsageReceipt / 旧 CLI 路径使用。
# 不建议直接复用为 ARC_AGENT_VALIDATOR_PRIVATE_KEY，因为 ERC-8004 不允许 self-feedback。
ARC_PRIVATE_KEY=0xyourprivatekey

# 你自己部署的 UsageReceipt 合约地址，用于把成功调用写成链上 receipt。
USAGE_RECEIPT_ADDRESS=0xYourReceiptContract

# Circle Console proof 开关：默认 false，避免页面/API 被误触发对 Circle Contracts library 发起写操作。
# 只有设置为 true 后，/arc/sd/live 里的 Circle Console Proof 按钮和 POST /api/circle/console/proof 才允许执行。
CIRCLE_CONSOLE_PROOF_ENABLED=false

# Circle Developer Console 测试 API key：只在服务端读取，用于读取 Wallets / Contracts 并导入 UsageReceipt。
CIRCLE_API_KEY=
CIRCLE_API_BASE_URL=https://api.circle.com

# Circle Console proof artifact 输出路径：保存 Wallets/Contracts 计数、Circle contractId、requestId，不保存 API key。
CIRCLE_CONSOLE_PROOF_ARTIFACT_PATH=artifacts/circle-console/proof.json

# 暂未由本项目消费：创建/管理托管钱包时才需要 Entity Secret；前端 App Kit 才需要 Kit Key。
CIRCLE_ENTITY_SECRET=
KIT_KEY=

# ERC-8004 agent owner 钱包私钥：负责注册 agent identity 和提交 validation request。
ARC_AGENT_OWNER_PRIVATE_KEY=0xyouragentownerprivatekey

# ERC-8004 validator 钱包私钥：负责给 agent 写 reputation feedback 和 validation response。
# 必须和 owner 是不同地址，否则 reputation feedback 会被合约拒绝。
ARC_AGENT_VALIDATOR_PRIVATE_KEY=0xyouragentvalidatorprivatekey

# ERC-8004 agent metadata URI：链上 agent identity 指向的项目/元数据说明。
ARC_AGENT_METADATA_URI=ipfs://your-agent-metadata

# ERC-8004 validation request URI：验证请求的附加说明，可选；不填时 runner 使用默认示例 URI。
ARC_AGENT_VALIDATION_REQUEST_URI=ipfs://your-validation-request

# ERC-8004 proof artifact 输出路径：保存 agentId、tx hash、ArcScan 链接，不保存私钥。
ARC_ERC8004_ARTIFACT_PATH=artifacts/arc-standards/erc8004-agent.json

# ERC-8183 client 钱包私钥：负责创建 job、approve USDC、fund escrow 和 complete job。
ARC_JOB_CLIENT_PRIVATE_KEY=0xyourjobclientprivatekey

# ERC-8183 provider 钱包私钥：负责 setBudget 和 submit deliverable。
# 需要有 Arc testnet gas；USDC budget 从 client 钱包支付。
ARC_JOB_PROVIDER_PRIVATE_KEY=0xyourjobproviderprivatekey

# ERC-8183 job 预算，单位是 USDC。示例 1 表示 1 USDC；真实试跑可用 0.1 这类小额。
ARC_JOB_BUDGET_USDC=1

# ERC-8183 job 描述：写入 job 创建流程，用来说明这次 proof 的业务语义。
ARC_JOB_DESCRIPTION=ERC-8183 demo job on Arc Testnet

# ERC-8183 proof artifact 输出路径：保存 jobId、各阶段 tx hash、finalStatus 和 ArcScan 链接。
ARC_ERC8183_ARTIFACT_PATH=artifacts/arc-standards/erc8183-job.json
